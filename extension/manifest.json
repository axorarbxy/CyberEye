{
  "manifest_version" : 3,
  "name" : "Cybereye Shadow AI Detector",
  "version" : "1.0",
  "description" : "Detects when sensitive data is sent to unauthorized AI tools",
  "permissions" : [
    "webRequest",
    "storage"
  ],
  "host_permissions" : [
    "<all_urls>"
  ],
  "background" : {
    "service_worker" : "background.js"
  },
  "action" : {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
